# === CẤU HÌNH TÀI KHOẢN / DATABASE cho Học Rẻ 365 ===
# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# 1) Database PostgreSQL — tạo miễn phí tại https://neon.tech
#    Sau khi tạo, copy "Connection string" dán vào đây (nhớ có ?sslmode=require).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 2) Khóa bí mật cho Auth.js — tạo bằng lệnh: npx auth secret
AUTH_SECRET="thay-bang-chuoi-ngau-nhien"

# 3) Đăng nhập Google — tạo OAuth Client tại https://console.cloud.google.com
#    (APIs & Services → Credentials → OAuth client ID → Web application)
#    Authorized redirect URI: https://khoahocre365.com/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# 4) URL web (để Auth.js tạo link callback đúng)
#    Local: http://localhost:3000  |  Production: https://khoahocre365.com
AUTH_URL="http://localhost:3000"
